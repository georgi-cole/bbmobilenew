# Copy to `.env.android` and set your Android backend URL here.
# This is used by `npm run build:android` and `npm run cap:sync:android`.
VITE_ANDROID_API_BASE_URL=https://api.example.com

# Google Play one-time, non-consumable product IDs.
VITE_VIP_PRODUCT_ID=com.georgicole.thebigeye.vip
VITE_SURVIVAL_MODE_PRODUCT_ID=com.georgicole.thebigeye.survival
VITE_PUBLIC_MODE_PRODUCT_ID=com.georgicole.thebigeye.publicmode
VITE_TRIBUNAL_HOUSE_PRODUCT_ID=com.georgicole.thebigeye.tribunalhouse
VITE_NO_ADS_PRODUCT_ID=com.georgicole.thebigeye.noads